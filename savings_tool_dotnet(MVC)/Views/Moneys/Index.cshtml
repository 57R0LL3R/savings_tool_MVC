@model IEnumerable<savings_tool_dotnet_MVC_.Models.Money>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.QuantityMoney)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ValueMoney)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Days)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalValue)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.QuantityMoney)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ValueMoney)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Days)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalValue)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdMoney">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdMoney">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdMoney">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
